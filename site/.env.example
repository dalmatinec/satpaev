# Домен сайта, например satbox.duckdns.org. Пусто = сайт открывается по IP без SSL.
# A-запись (на DuckDNS просто IP в поле current ip) должна смотреть на этот сервер.
SITE_ADDRESS=
# Почта для Let's Encrypt (необязательно)
SSL_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# Где работает бот (сайт берёт у него курсы, цены, тексты, проверку юзеров).
# Бот на этом же сервере: оставьте пустым. На другом: http://IP_БОТА:8090
# (и на сервере бота откройте порт 8090 только для IP сайта, см. README).
API_UPSTREAM=
