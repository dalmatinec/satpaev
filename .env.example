# ===== Бот =====
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram id (узнать у @userinfobot). Несколько через запятую, первый получает бэкапы
ADMIN_IDS=
# Название магазина (можно поменять потом в админке)
BRAND_NAME=Satpaev
TZ=Asia/Almaty

# ===== Канал =====
# @username канала или его id вида -100...
CHANNEL_ID=
# Куда публиковать отзывы (если пусто, в тот же канал)
REVIEWS_CHANNEL_ID=

# ===== Постинг от вашего аккаунта (премиум эмодзи) =====
# Получить на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Пауза между постами в секундах (защита аккаунта)
POSTER_MIN_INTERVAL=20

# ===== База (пароль генерирует setup.sh) =====
POSTGRES_DB=satpaev
POSTGRES_USER=satpaev
POSTGRES_PASSWORD=

# ===== Бэкапы =====
BACKUP_TIME=04:00
# Сколько последних бэкапов хранить на сервере
BACKUP_KEEP=1

# ===== Сайт =====
# Сайт разворачивается отдельно (папка site, см. README). Ссылка для кнопки в боте, когда будет домен:
SITE_URL=
